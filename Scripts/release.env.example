# Copy to Scripts/release.env and adjust. Read by Scripts/release.sh.

# A public GitHub repository that holds the releases, as owner/name.
GITHUB_REPO=Sirdug/Mac-fan

# Optional: sign with a certificate from your keychain instead of ad hoc.
# List yours with: security find-identity -v -p codesigning
# SIGN_IDENTITY="Apple Development: you@example.com (TEAMID)"
